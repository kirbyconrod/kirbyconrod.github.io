 @inbook{conrod2025care,
	 author = {Conrod, Kirby},
	 editor = {Robinson, Octavian and Moriarty, Erin and Henner, Jon},
	 booktitle = {The Crip Linguistics Reader},
	 title = {Linguistic care work},
	 year = {2025},
	 publisher = {Gallaudet University Press},
	 keywords = {TK},
	 abstract = {Any symbolic, semiotic, or linguistic locus that can be a site of harm can also be a site
of care. In this chapter, I outline my proposed framework for analyzing linguistic care
work, which I define as any speech act that protects someone from harm, affords heal-
ing from past harm, or creates a sense of interpersonal interreliance. This can be con-
ceived of as a kind of mutual aid that is created through language. I posit that linguistic
care work can include the collectivization and/or redistribution of symbolic capital, as
well as the amelioration of symbolic violence. In this chapter, I focus on the way gen-
dered pronouns are used for linguistic care work in queer, trans, and disabled circles
that I am a part of. These are intended to serve primarily as a case study for building
out the notion of linguistic care work, which I intend to be compatible with any other
framework for analyzing language and linguistic behaviors. I will also discuss the ways
in which transmedicalism co-opts true linguistic care work into systems of othering
trans and disabled bodies and minds.}
 },

